	<http://syn.org/node> <http://syn.org/mc2/10x_visium_rna_level_3>;
	<http://syn.org/type> "number";
	<http://syn.org/isCDE> 11556322 .

<http://syn.org/mc2/10x_visium_rna_level_3/visium_proportion_reads_mapped> <http://www.w3.org/2000/01/rdf-schema#label> "Visium Proportion Reads Mapped";
	<http://purl.org/dc/terms/description> "Proportion of mapped reads collected from samtools. Number";
	<http://syn.org/node> <http://syn.org/mc2/10x_visium_rna_level_3>;
	<http://syn.org/type> "number" .

<http://syn.org/mc2/10x_visium_rna_level_3/visium_proportion_reads_mapped_to_transcriptome> <http://www.w3.org/2000/01/rdf-schema#label> "Visium Proportion Reads Mapped to Transcriptome";
	<http://purl.org/dc/terms/description> "Fraction of reads that mapped to a unique gene in the transcriptome. The read must be consistent with annotated splice junctions. These reads are considered for UMI counting.";
