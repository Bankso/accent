	<http://syn.org/node> <http://syn.org/mc2/10x_visium_auxiliary_files>;
	<http://syn.org/type> "string" .

<http://syn.org/mc2/10x_visium_auxiliary_files/10xvisiumrnalevel4_key> <http://www.w3.org/2000/01/rdf-schema#label> "10xVisiumRNALevel4 Key";
