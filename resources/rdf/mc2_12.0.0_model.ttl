<http://syn.org/mc2/tool_view/tool_compute_requirements> <http://www.w3.org/2000/01/rdf-schema#label> "Tool Compute Requirements";
	<http://purl.org/dc/terms/description> "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (examples: DirectX, Java or .NET runtime).";
