	<http://syn.org/requiredBy> <http://syn.org/mc2/10x_visium_auxiliary_files>;
	<http://syn.org/isKey> true .

<http://syn.org/mc2/10x_visium_auxiliary_files/10xvisiumrnalevel1_key> <http://www.w3.org/2000/01/rdf-schema#label> "10xVisiumRNALevel1 Key";
	<http://purl.org/dc/terms/description> "Unique 10xVisiumRNALevel1_id foreign key(s) that link metadata entries as part of the same Dataset. Please provide multiple values as a comma-separate list.";
	<http://syn.org/node> <http://syn.org/mc2/10x_visium_auxiliary_files>;
	<http://syn.org/type> "string" .

<http://syn.org/mc2/10x_visium_auxiliary_files/10xvisiumrnalevel2_key> <http://www.w3.org/2000/01/rdf-schema#label> "10xVisiumRNALevel2 Key";
