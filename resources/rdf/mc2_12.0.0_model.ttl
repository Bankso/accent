<http://syn.org/mc2/10x_visium_rna_level_3/visium_spots_under_tissue> <http://www.w3.org/2000/01/rdf-schema#label> "Visium Spots under tissue";
	<http://purl.org/dc/terms/description> "The number of barcodes associated with a spot under tissue.";
	<http://syn.org/node> <http://syn.org/mc2/10x_visium_rna_level_3>;
	<http://syn.org/type> "number";
	<http://syn.org/requiredBy> <http://syn.org/mc2/10x_visium_rna_level_3> .

<http://syn.org/mc2/10x_visium_rna_level_3/visium_mean_reads_per_spatial_spot> <http://www.w3.org/2000/01/rdf-schema#label> "Visium Mean Reads per Spatial Spot";
	<http://purl.org/dc/terms/description> "The number of reads, both under and outside of tissue, divided by the number of barcodes associated with a spot under tissue.";
	<http://syn.org/node> <http://syn.org/mc2/10x_visium_rna_level_3>;
	<http://syn.org/type> "number";
	<http://syn.org/requiredBy> <http://syn.org/mc2/10x_visium_rna_level_3> .

<http://syn.org/mc2/10x_visium_rna_level_3/visium_median_number_genes_per_spatial_spot> <http://www.w3.org/2000/01/rdf-schema#label> "Visium Median Number Genes per Spatial Spot";
	<http://purl.org/dc/terms/description> "The median number of genes detected per spot under tissue-associated barcode. Detection is defined as the presence of at least 1 UMI count.";
	<http://syn.org/node> <http://syn.org/mc2/10x_visium_rna_level_3>;
	<http://syn.org/type> "number";
	<http://syn.org/requiredBy> <http://syn.org/mc2/10x_visium_rna_level_3> .

