	<http://syn.org/type> "string;enum" .

<http://syn.org/mc2/biospecimen/Biospecimen_Known_Metastasis_Sites> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Known Metastasis Sites";
