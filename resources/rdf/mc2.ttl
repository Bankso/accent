	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string" .

<http://syn.org/mc2/biospecimen/Biospecimen_Disease_Type> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Disease Type";
