	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string;enum" .

<http://syn.org/mc2/biospecimen/Biospecimen_Description> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Description";
