	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string;enum";
	<http://syn.org/isCDE> 14156279 .

<http://syn.org/mc2/biospecimen/Biospecimen_Site_of_Resection_or_Biopsy> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Site of Resection or Biopsy";
