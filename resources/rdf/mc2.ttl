	<http://syn.org/type> "string";
	<http://syn.org/requiredBy> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/isCDE> 8120269 .

<http://syn.org/mc2/biospecimen/Biospecimen_Timepoint_Offset> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Timepoint Offset";
	<http://purl.org/dc/terms/description> "The number of days that elapsed before the biospecimen was collected, relative to the event described by Biospecimen Timepoint Type. Floating point values are allowed.";
	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "number" .

<http://syn.org/mc2/biospecimen/Biospecimen_Last_Known_Disease_Status> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Last Known Disease Status";
