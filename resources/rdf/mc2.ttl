	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string" .

<http://syn.org/mc2/biospecimen/Parent_Biospecimen_Key> <http://www.w3.org/2000/01/rdf-schema#label> "Parent Biospecimen Key";
