	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string;enum";
	<http://syn.org/isCDE> 2002 .

<http://syn.org/mc2/biospecimen/Biospecimen_Treatment_Type> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Treatment Type";
	<http://purl.org/dc/terms/description> "Text term that describes the kind of treatment administered.";
	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string;enum";
	<http://syn.org/isCDE> 14737565 .

