<http://syn.org/mc2/biospecimen/Biospecimen_Tumor_Subtype> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Tumor Subtype";
	<http://purl.org/dc/terms/description> "The subtype related to the scientific determination and investigation, analysis and recognition of the presence and nature of disease, condition, or injury from expressed signs and symptoms of tissue growth resulting from uncontrolled cell proliferation.";
	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string" .

<http://syn.org/mc2/biospecimen/Biospecimen_Tumor_Grade> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Tumor Grade";
	<http://purl.org/dc/terms/description> "Numeric value to express the degree of abnormality of cancer cells, a measure of differentiation and aggressiveness.";
