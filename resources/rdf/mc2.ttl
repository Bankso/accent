	<http://syn.org/node> <http://syn.org/mc2/datasetView>;
	<http://syn.org/type> "string";
	<http://syn.org/isKey> true .

<http://syn.org/mc2/datasetView/PublicationView_Key> <http://www.w3.org/2000/01/rdf-schema#label> "PublicationView Key";
