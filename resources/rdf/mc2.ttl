	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string;enum";
	<http://syn.org/isCDE> 14714127 .

<http://syn.org/mc2/biospecimen/Biospecimen_Treatment_Response> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Treatment Response";
	<http://purl.org/dc/terms/description> "Text term that describes the treatment response of a model or patient from which this specimen was derived.";
	<http://syn.org/node> <http://syn.org/mc2/biospecimen>;
	<http://syn.org/type> "string;enum";
	<http://syn.org/isCDE> 13383448 .

<http://syn.org/mc2/biospecimen/Biospecimen_Incidence_Type> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Incidence Type";
