	<http://syn.org/type> "string;enum";
	<http://syn.org/isCDE> 11325685 .

<http://syn.org/mc2/biospecimen/Biospecimen_Composition> <http://www.w3.org/2000/01/rdf-schema#label> "Biospecimen Composition";
